{
	"info": {
		"_postman_id": "b1c2d3e4-5f6a-4b7c-8d9e-0f1a2b3c4d5e",
		"name": "PotterTravis_Assignment4_PostmanCollection",
		"description": "Postman collection for the Chapter 4 Licensing Service assignment (SFWE410). Exercises Create/Read/Update/Delete against com.optimagrowth.license.controller.LicenseController, running in Docker against the Postgres database defined in docker-compose.yml.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "License CRUD",
			"item": [
				{
					"name": "Create License",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"licenseId\": \"{{licenseId}}\",\n    \"organizationId\": \"{{organizationId}}\",\n    \"description\": \"Software product\",\n    \"productName\": \"Ostock\",\n    \"licenseType\": \"complete\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/v1/organization/{{organizationId}}/license",
							"host": [ "{{baseUrl}}" ],
							"path": [ "v1", "organization", "{{organizationId}}", "license" ]
						},
						"description": "Creates a new license for the given organization. Persisted via Spring Data JPA to the Postgres 'licenses' table."
					},
					"response": []
				},
				{
					"name": "Get License",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/organization/{{organizationId}}/license/{{licenseId}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "v1", "organization", "{{organizationId}}", "license", "{{licenseId}}" ]
						},
						"description": "Retrieves the license identified by licenseId for the given organization from Postgres."
					},
					"response": []
				},
				{
					"name": "Update License",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"licenseId\": \"{{licenseId}}\",\n    \"organizationId\": \"{{organizationId}}\",\n    \"description\": \"Software product (updated)\",\n    \"productName\": \"Ostock\",\n    \"licenseType\": \"complete\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/v1/organization/{{organizationId}}/license",
							"host": [ "{{baseUrl}}" ],
							"path": [ "v1", "organization", "{{organizationId}}", "license" ]
						},
						"description": "Updates the license for the given organization and persists the change to Postgres."
					},
					"response": []
				},
				{
					"name": "Delete License",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/organization/{{organizationId}}/license/{{licenseId}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "v1", "organization", "{{organizationId}}", "license", "{{licenseId}}" ]
						},
						"description": "Deletes the license identified by licenseId for the given organization from Postgres."
					},
					"response": []
				},
				{
					"name": "Get License (Not Found)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/organization/{{organizationId}}/license/{{licenseId}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "v1", "organization", "{{organizationId}}", "license", "{{licenseId}}" ]
						},
						"description": "Run after Delete License to confirm the row is gone from Postgres (expects HTTP 404)."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
		{ "key": "organizationId", "value": "test-org-1", "type": "string" },
		{ "key": "licenseId", "value": "test-license-1", "type": "string" }
	]
}
